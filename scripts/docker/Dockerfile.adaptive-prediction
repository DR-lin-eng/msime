FROM rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv cmake pkg-config libasound2-dev git ca-certificates && rm -rf /var/lib/apt/lists/*
RUN rustup component add rustfmt clippy
RUN python3 -m venv /opt/prediction-test && /opt/prediction-test/bin/pip install --no-cache-dir onnx==1.23.2 onnxruntime==1.24.4
ENV PATH=/opt/prediction-test/bin:$PATH
WORKDIR /source
